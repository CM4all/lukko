#pragma once

#include <sodium/version.h>

/* ML-KEM-768 was added in libsodium 1.0.22 (library version 26.4) */
#if SODIUM_LIBRARY_VERSION_MAJOR > 26 || \
	(SODIUM_LIBRARY_VERSION_MAJOR == 26 && SODIUM_LIBRARY_VERSION_MINOR >= 4)
#define HAVE_MLKEM768
#endif

#ifdef HAVE_MLKEM768

#include "KexInterface.hxx"
#include "KexEnums.hxx"

#include <array>
#include <cstddef>

namespace SSH {

static constexpr std::size_t MLKEM768_PUBLIC_KEY_SIZE = 1184;
static constexpr std::size_t MLKEM768_SECRET_KEY_SIZE = 2400;
static constexpr std::size_t MLKEM768_CIPHERTEXT_SIZE = 1088;
static constexpr std::size_t MLKEM768_SHARED_KEY_SIZE = 32;

/**
 * The hybrid key exchange algorithm "mlkem768x25519-sha256"
 * (draft-ietf-sshm-mlkem-hybrid-kex).
 *
 * The client's ephemeral public key is the ML-KEM-768 encapsulation
 * key followed by the X25519 public key; the server's ephemeral
 * public key is the ML-KEM-768 ciphertext followed by the X25519
 * public key.
 */
class Mlkem768X25519Kex final : public Kex {
	const Role role;

	std::array<std::byte, 32> x25519_secret_key;

	/**
	 * The ML-KEM-768 key pair (only used by the client).
	 */
	std::array<std::byte, MLKEM768_PUBLIC_KEY_SIZE> mlkem_public_key;
	std::array<std::byte, MLKEM768_SECRET_KEY_SIZE> mlkem_secret_key;

	/**
	 * The ML-KEM-768 ciphertext generated by
	 * GenerateSharedSecret() (only used by the server).
	 */
	std::array<std::byte, MLKEM768_CIPHERTEXT_SIZE> mlkem_ciphertext;

public:
	explicit Mlkem768X25519Kex(Role _role);
	~Mlkem768X25519Kex() noexcept override;

	/**
	 * On the server, this must be called after
	 * GenerateSharedSecret().
	 */
	void SerializeEphemeralPublicKey(Serializer &s) const override;

	void GenerateSharedSecret(std::span<const std::byte> peer_ephemeral_public_key,
				  Serializer &s) override;
};

} // namespace SSH

#endif // HAVE_MLKEM768
